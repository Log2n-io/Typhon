<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <Configurations>Debug;Release</Configurations>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.3.0" />
    <PackageReference Include="NUnit" Version="4.6.1" />
    <PackageReference Include="NUnit3TestAdapter" Version="6.2.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.7.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Reference the analyzers as a normal assembly reference so tests can instantiate the analyzer types directly. -->
    <ProjectReference Include="..\..\src\Typhon.Analyzers\Typhon.Analyzers.csproj" />
    <!-- For ONE assertion: TYPHON012's byte limit is a copy of ComponentValue.MaxPayloadSize, which a netstandard2.0 analyzer cannot reference, and a copy
         with nothing checking it is a copy that rots. See TheInlinePayloadConstantMatchesTheEngines. -->
    <ProjectReference Include="..\..\src\Typhon.Engine\Typhon.Engine.csproj" />
  </ItemGroup>

</Project>
