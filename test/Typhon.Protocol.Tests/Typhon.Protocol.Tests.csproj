<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <IsPackable>false</IsPackable>
        <LangVersion>default</LangVersion>
        <Configurations>Debug;Release</Configurations>
        <!-- Zero-warning policy, matching Typhon.Engine.Tests: this suite builds clean, so every warning is an error. -->
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    </PropertyGroup>

    <!-- A netstandard2.1-subject run builds into its own directories, so it never overwrites the default build that a later no-build run tests. -->
    <PropertyGroup Condition="'$(TyphonSubjectTfm)' != ''">
        <OutputPath>bin\$(Configuration)\subject-$(TyphonSubjectTfm)$(TyphonProtocolTfm)\</OutputPath>
        <IntermediateOutputPath>obj\$(Configuration)\subject-$(TyphonSubjectTfm)$(TyphonProtocolTfm)\</IntermediateOutputPath>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="NUnit" Version="4.6.1" />
        <PackageReference Include="NUnit3TestAdapter" Version="6.2.0" />
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.7.0" />
    </ItemGroup>

    <ItemGroup>
        <!-- -p:TyphonSubjectTfm=netstandard2.1 runs these same tests against the subject's netstandard2.1 build — the one Unity loads (#1034) — on
             CoreCLR: its polyfills, its Bcl ports, and the golden vectors through them. CI runs it beside the default (net10.0) run. -->
        <ProjectReference Include="..\..\src\Typhon.Protocol\Typhon.Protocol.csproj" Condition="'$(TyphonSubjectTfm)' == ''" />
        <ProjectReference Include="..\..\src\Typhon.Protocol\Typhon.Protocol.csproj" Condition="'$(TyphonSubjectTfm)' != ''" SetTargetFramework="TargetFramework=$(TyphonSubjectTfm)" />
    </ItemGroup>

</Project>
