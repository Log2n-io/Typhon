<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <config>
    <add key="globalPackagesFolder" value="$PACKAGES$" />
  </config>
  <packageSources>
    <clear />
    <add key="typhon-eval" value="$FEED$" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="typhon-eval">
      <package pattern="Typhon" />
      <package pattern="Typhon.Protocol" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
