{
    "environment": [
        {
            "type": "env",
            "key": "TYPHON_DOCS_SOURCE",
            "value": "C:\\Dev\\github\\Typhon\\claude"
        },
        {
            "type": "env",
            "key": "TYPHON_AIR_PREWARM",
            "value": "1"
        },
        {
            "type": "env",
            "key": "DOTNET_CLI_TELEMETRY_OPTOUT",
