@page "/"
@implements IDisposable
@inject DashboardFeed Feed

<PageTitle>Tatooine dashboard</PageTitle>

@{
    var s = Feed.Latest;
    var st = s.Stats;
    var hl = s.Health;
}

<header class="top">
    <h1>Tatooine</h1>
    <span class="dot @(s.Up ? "up" : "down")"></span>
    <span class="muted">@(s.Up ? "live" : $"server not answering: {s.Error}")</span>
    <span class="muted">· @Feed.Server · read @Age(s.At) ago</span>
    <nav class="links"><a href="bots">Bots →</a></nav>
</header>

<main class="grid">
    <section class="card">
        <h2>Server health</h2>
        <div class="kpis">
            @Kpi("tick p50", Ms(N(hl, "tickMs", "p50")))
            @Kpi("tick p99", Ms(N(hl, "tickMs", "p99")), Warn(N(hl, "tickMs", "p99"), N(hl, "tickMs", "target") * 0.5))
            @Kpi("budget", Ms(N(hl, "tickMs", "target")))
            @Kpi("overruns", F(N(hl, "tickMs", "overruns"), 0), N(hl, "tickMs", "overruns") > 0)
            @Kpi("sessions", F(N(hl, "replication", "sessions"), 0))
            @Kpi("track p99", Ms(N(hl, "replication", "trackP99Ms")))
            @Kpi("out", $"{F(s.OutMBps, 1)} MB/s")
            @Kpi("WAL wait p99", Ms(N(hl, "durabilityMs", "waitP99")))
        </div>
        @Spark("tick p99", "ms")
        <h3>Systems, mean per tick</h3>
        <table class="bars">
            @foreach (var (name, us) in Systems(hl))
            {
                <tr><td>@name</td><td class="num">@F(us, 0) µs</td><td class="bar"><div style="width:@Pct(us, MaxSystem(hl))"></div></td></tr>
            }
        </table>
    </section>

    <section class="card">
        <h2>Who is playing</h2>
        <div class="kpis">
            @Kpi("bots", F(N(st, "population", "bots"), 0))
            @Kpi("people", F(N(st, "population", "people"), 0))
            @Kpi("crowd", F(N(st, "population", "crowd"), 0))
            @Kpi("bots indoors", F(N(st, "population", "botsIndoors"), 0))
            @Kpi("bots outside a city", F(N(st, "population", "botsElsewhere"), 0))
        </div>
        @Spark("bots", "")
        <h3>Bots per city</h3>
        <table class="bars">
            @foreach (var (city, n) in Cities(st))
            {
                <tr><td>@city</td><td class="num">@F(n, 0)</td><td class="bar"><div style="width:@Pct(n, N(st, "population", "bots"))"></div></td></tr>
            }
        </table>
    </section>

    <section class="card">
        <h2>Economy</h2>
        <div class="kpis">
            @Kpi("transactions / s", Rate(st, "economy", "transfersPerSec"))
            @Kpi("tips / s", Rate(st, "economy", "tipsPerSec"))
            @Kpi("rewards / min", Rate(st, "economy", "rewardsPerMin"))
            @Kpi("wallets opened / min", Rate(st, "economy", "walletsOpenedPerMin"))
            @Kpi("rows since start", F(N(st, "economy", "transfers"), 0))
            @Kpi("wallets opened since start", F(N(st, "economy", "walletsOpened"), 0))
            @Kpi("rewards since start", F(N(st, "economy", "rewardsPaid"), 0))
            @Kpi("tips refused since start", F(N(st, "economy", "tipsRefused"), 0))
            @Kpi("failed commits", F(N(st, "economy", "commitsFailed"), 0), N(st, "economy", "commitsFailed") > 0)
        </div>
        @Spark("tx/s", "/s")
        <h3>Audit</h3>
        @if (s.Audit is null)
        {
            <p class="muted">not run yet</p>
        }
        else
        {
            var ok = s.Audit["ok"]?.GetValue<bool>() ?? false;
            <p>
                <span class="badge @(ok ? "ok" : "bad")">@(ok ? "consistent" : "VIOLATIONS")</span>
                @F(N(s.Audit, "entries"), 0) rows replayed, @F(N(s.Audit, "wallets"), 0) wallets,
                Σ wallets + World = @F(N(s.Audit, "sum"), 0), in @Ms(N(s.Audit, "ms")) — @Age(s.AuditAt) ago
            </p>
            @if (!ok && s.Audit["violations"] is JsonArray v)
            {
                <ul class="violations">@foreach (var line in v.Take(10)) { <li>@line</li> }</ul>
            }
        }
        <h3>Latest transfers</h3>
        <table class="ledger">
            <tr><th>seq</th><th>tick</th><th>kind</th><th>from</th><th>to</th><th class="num">amount</th></tr>
            @if (s.Ledger?["rows"] is JsonArray rows)
            {
                @foreach (var r in rows.Reverse())
                {
                    <tr>
                        <td>@r?["seq"]</td><td>@r?["tick"]</td><td>@r?["kind"]</td>
                        <td>@Account(r?["from"])</td><td>@Account(r?["to"])</td><td class="num">@r?["amount"]</td>
                    </tr>
                }
            }
        </table>
    </section>

    <section class="card">
        <h2>Items</h2>
        @if (st?["items"] is null)
        {
            <p class="muted">this server has no items</p>
        }
        else
        {
            <div class="kpis">
                @Kpi("drops / min", Rate(st, "items", "dropsPerMin"))
                @Kpi("units / min", Rate(st, "items", "unitsPerMin"))
                @Kpi("lost / min", Rate(st, "items", "lostPerMin"))
                @Kpi("stacks", F(N(st, "items", "stacks"), 0))
                @Kpi("rows since start", F(N(st, "items", "rows"), 0))
                @Kpi("drops since start", F(N(st, "items", "drops"), 0))
                @Kpi("refused", F(N(st, "items", "refused"), 0))
                @Kpi("queue overflow", F(N(st, "items", "queueOverflow"), 0), N(st, "items", "queueOverflow") > 0)
                @Kpi("failed commits", F(N(st, "items", "commitsFailed"), 0), N(st, "items", "commitsFailed") > 0)
            </div>
            @Spark("drops/min", "/min")
            <h3>Units held, by Mk</h3>
            <table class="ledger">
                <tr>
                    <th>item</th><th class="num">I</th><th class="num">II</th><th class="num">III</th><th class="num">IV</th><th class="num">V</th>
                    <th class="num" title="an item without Mk">no Mk</th>
                </tr>
                @foreach (var (id, name) in HeldRows(st))
                {
                    var held = Held(st, id);
                    <tr>
                        <td title="@id">@name</td>
                        @for (var mk = 0; mk < 5; mk++)
                        {
                            <td class="num">@(held.Length == 1 ? "—" : F(At(held, mk), 0))</td>
                        }
                        <td class="num">@(held.Length == 1 ? F(held[0], 0) : "—")</td>
                    </tr>
                }
            </table>
        }
        <h3>Item audit</h3>
        @if (s.ItemAudit is null)
        {
            <p class="muted">not run yet</p>
        }
        else
        {
            var itemsOk = s.ItemAudit["ok"]?.GetValue<bool>() ?? false;
            <p>
                <span class="badge @(itemsOk ? "ok" : "bad")">@(itemsOk ? "consistent" : "VIOLATIONS")</span>
                @F(N(s.ItemAudit, "entries"), 0) rows replayed, @F(N(s.ItemAudit, "stacks"), 0) stacks, @F(N(s.ItemAudit, "units"), 0) units held
                = @F(N(s.ItemAudit, "minted"), 0) minted − @F(N(s.ItemAudit, "destroyed"), 0) destroyed, in @Ms(N(s.ItemAudit, "ms")) — @Age(s.AuditAt) ago
            </p>
            @if (!itemsOk && s.ItemAudit["violations"] is JsonArray iv)
            {
                <p class="muted">@F(N(s.ItemAudit, "violationCount"), 0) violation(s)</p>
                <ul class="violations">@foreach (var line in iv.Take(10)) { <li>@line</li> }</ul>
            }
        }
    </section>

    <section class="card">
        <h2>Market</h2>
        @if (st?["market"] is null)
        {
            <p class="muted">this server has no market</p>
        }
        else
        {
            <div class="kpis">
                @Kpi("sales / min", Rate(st, "market", "salesPerMin"))
                @Kpi("volume / min, cr", Rate(st, "market", "volumePerMin"))
                @Kpi("vendor paid / min, cr", Rate(st, "market", "vendorPerMin"))
                @Kpi("fees + tax / min, cr", Rate(st, "market", "feesPerMin"))
                @Kpi("listed now", F(N(st, "market", "listed"), 0))
                @Kpi("awaiting collection", F(N(st, "market", "sold") + N(st, "market", "returned"), 0))
                @Kpi("units in escrow", F(N(st, "market", "escrowUnits"), 0))
                @Kpi("sales since start", F(N(st, "market", "sales"), 0))
                @Kpi("volume since start, cr", F(N(st, "market", "volume"), 0))
                @Kpi("unsold age p50 · p90 · max",
                    $"{Dur(N(st, "market", "unsoldAgeS", "p50"))} · {Dur(N(st, "market", "unsoldAgeS", "p90"))} · {Dur(N(st, "market", "unsoldAgeS", "max"))}")
                @Kpi("refused", F(Refused(st).Sum(r => r.N), 0))
                @Kpi("failed commits", F(N(st, "market", "commitsFailed"), 0), N(st, "market", "commitsFailed") > 0)
                @Kpi("aborted", F(N(st, "market", "aborted"), 0), N(st, "market", "aborted") > 0)
            </div>
            @if (Refused(st).Any(r => r.N > 0))
            {
                <p class="muted small">refused: @string.Join(" · ", Refused(st).Where(r => r.N > 0).OrderByDescending(r => r.N).Select(r => $"{r.Reason} {F(r.N, 0)}"))</p>
            }
            @Spark("sales/min", "/min")
            <h3>Faucets and sinks, credits since start</h3>
            <div class="kpis">
                @Kpi("minted / min (faucets)", Rate(st, "economy", "faucetsPerMin"))
                @Kpi("destroyed / min (sinks)", Rate(st, "economy", "sinksPerMin"))
                @Kpi("sinks ÷ faucets", Pct(N(st, "economy", "sinks"), N(st, "economy", "faucets")))
            </div>
            <table class="ledger">
                <tr><th>kind</th><th>flow</th><th class="num">credits</th></tr>
                @foreach (var (kind, credits) in ByKind(st))
                {
                    <tr><td>@kind</td><td class="muted">@FlowOf(kind)</td><td class="num">@F(credits, 0)</td></tr>
                }
                <tr><td><b>faucets</b></td><td></td><td class="num">@F(N(st, "economy", "faucets"), 0)</td></tr>
                <tr><td><b>sinks</b></td><td></td><td class="num">@F(N(st, "economy", "sinks"), 0)</td></tr>
            </table>
            @Spark("faucets/min", " cr/min")
            @Spark("sinks/min", " cr/min")
            <h3>Listings by city</h3>
            <table class="bars">
                <tr><th>city</th><th class="num">listed</th><th class="num">reserved</th><th class="num">value, cr</th><th></th></tr>
                @foreach (var c in MarketCities(st))
                {
                    <tr>
                        <td>@c.Name</td><td class="num">@F(c.Listed, 0)</td><td class="num">@F(c.Reserved, 0)</td><td class="num">@F(c.Value, 0)</td>
                        <td class="bar"><div style="width:@Pct(c.Listed, N(st, "market", "listed"))"></div></td>
                    </tr>
                }
            </table>
            <h3>Price index — median ÷ market value</h3>
            @if (!Prices(st).Any())
            {
                <p class="muted">nothing sold or listed yet</p>
            }
            else
            {
                <table class="ledger">
                    <tr>
                        <th>item</th><th>Mk</th><th class="num">sales</th><th class="num">median</th><th class="num">min – max</th><th class="num">value</th>
                        <th class="num" title="green: 0.8 – 1.2">index</th><th class="num">listed · lowest</th>
                    </tr>
                    @foreach (var p in Prices(st))
                    {
                        var index = p.Sales > 0 && p.Value > 0 ? p.Median / p.Value : double.NaN;
                        <tr>
                            <td title="@p.Id">@ItemName(p.Id)</td><td>@Roman(p.Mk)</td><td class="num">@F(p.Sales, 0)</td>
                            <td class="num">@(p.Sales > 0 ? F(p.Median, 0) : "—")</td>
                            <td class="num">@(p.Sales > 0 ? $"{F(p.Min, 0)} – {F(p.Max, 0)}" : "—")</td>
                            <td class="num">@F(p.Value, p.Value < 10 ? 1 : 0)</td>
                            <td class="num" style="color:@IndexColour(index)">@F(index, 2)</td>
                            <td class="num">@F(p.Listed, 0)@(p.Listed > 0 ? $" · {F(p.Lowest, 0)}" : "")</td>
                        </tr>
                    }
                </table>
                <p class="muted small">median, min and max over the recent sales; credits per unit</p>
            }
        }
        <h3>Market audit</h3>
        @if (s.MarketAudit is null)
        {
            <p class="muted">not run yet</p>
        }
        else
        {
            var marketOk = s.MarketAudit["ok"]?.GetValue<bool>() ?? false;
            <p>
                <span class="badge @(marketOk ? "ok" : "bad")">@(marketOk ? "consistent" : "VIOLATIONS")</span>
                @F(N(s.MarketAudit, "listings"), 0) listings (@F(N(s.MarketAudit, "listed"), 0) listed, @F(N(s.MarketAudit, "sold"), 0) sold,
                @F(N(s.MarketAudit, "returned"), 0) returned), @F(N(s.MarketAudit, "sales"), 0) sales, @F(N(s.MarketAudit, "escrowUnits"), 0) units in escrow,
                in @Ms(N(s.MarketAudit, "ms")) — @Age(s.AuditAt) ago
            </p>
            @if (!marketOk && s.MarketAudit["violations"] is JsonArray mv)
            {
                <p class="muted">@F(N(s.MarketAudit, "violationCount"), 0) violation(s)</p>
                <ul class="violations">@foreach (var line in mv.Take(10)) { <li>@line</li> }</ul>
            }
        }
    </section>

    <section class="card">
        <h2>Missions</h2>
        <div class="kpis">
            @Kpi("taken / min", Rate(st, "missions", "takenPerMin"))
            @Kpi("completed / min", Rate(st, "missions", "completedPerMin"))
            @Kpi("cancelled / min", Rate(st, "missions", "cancelledPerMin"))
            @Kpi("held now", F(N(st, "missions", "held"), 0))
            @Kpi("offers listed", F(N(st, "missions", "offers"), 0))
            @Kpi("taken since start", F(N(st, "missions", "taken"), 0))
            @Kpi("completed since start", F(N(st, "missions", "completed"), 0))
            @Kpi("cancelled since start", F(N(st, "missions", "cancelled"), 0))
            @Kpi("retargeted", F(N(st, "missions", "retargeted"), 0))
        </div>
        @Spark("missions done/min", "/min")
    </section>

    <section class="card">
        <h2>Progression</h2>
        <div class="kpis">
            @Kpi("mean CL, people", F(N(st, "progression", "meanCl", "people"), 1))
            @Kpi("mean CL, bots", F(N(st, "progression", "meanCl", "bots"), 1))
            @Kpi("people by CL band", ClBands(st, "people"))
            @Kpi("bots by CL band", ClBands(st, "bots"))
            @Kpi("XP / char-hour", Rate(st, "progression", "xpPerCharHour"))
            @Kpi("model's XP / char-hour", F(N(st, "progression", "modelXpPerCharHour"), 0))
            @Kpi("kill : mission XP", $"{Pct(N(st, "progression", "killXp"), N(st, "progression", "killXp") + N(st, "progression", "missionXp"))} : {Pct(N(st, "progression", "missionXp"), N(st, "progression", "killXp") + N(st, "progression", "missionXp"))}")
            @Kpi("level-ups / min", Rate(st, "progression", "levelUpsPerMin"))
            @Kpi("level-ups since start", F(N(st, "progression", "levelUps"), 0))
            @Kpi("grey kills", F(N(st, "progression", "greyKills"), 0))
            @Kpi("crowd kills", F(N(st, "progression", "crowdKills"), 0))
            @Kpi("XP commits failed", F(N(st, "progression", "commitsFailed"), 0), N(st, "progression", "commitsFailed") > 0)
        </div>
        @Spark("xp/char-hour", "/h")
        @Spark("level-ups/min", "/min")
    </section>

    <section class="card">
        <h2>The crowd at the lairs</h2>
        <div class="kpis">
            @Kpi("lair hits / s", Rate(st, "crowd", "lairHitsPerSec"))
            @Kpi("lairs by band I-V", Bands(st, "lairsByBand"), EmptyBand(st))
            @Kpi("lairs the crowd may fight", F(N(st, "levels", "lairsBelowCrowdLevel"), 0), N(st, "levels", "lairsBelowCrowdLevel") == 0)
            @Kpi("crowd objective level max", F(N(st, "levels", "crowdObjectiveLevelMax"), 0), N(st, "levels", "crowdObjectiveLevelMax") > 10)
            @Kpi("objectives taken", F(N(st, "crowd", "objectivesTaken"), 0))
            @Kpi("objectives fallen", F(N(st, "crowd", "objectivesFallen"), 0))
            @Kpi("given up", F(N(st, "crowd", "objectivesGivenUp"), 0))
            @Kpi("in range checks", F(N(st, "crowd", "heldInRange"), 0))
            @Kpi("out of range", F(N(st, "crowd", "outOfRange"), 0), N(st, "crowd", "outOfRange") > 0)
        </div>
        @Spark("lair hits/s", "/s")
    </section>
</main>

@code {
    protected override void OnInitialized() => Feed.Changed += Refresh;

    public void Dispose() => Feed.Changed -= Refresh;

    private void Refresh() => _ = InvokeAsync(StateHasChanged);

    private static double N(JsonNode node, params string[] path) => DashboardFeed.Number(node, path);

    private static string F(double v, int digits) => double.IsNaN(v) ? "—" : v.ToString(digits == 0 ? "N0" : "N" + digits, CultureInfo.InvariantCulture);

    private static string Ms(double v) => double.IsNaN(v) ? "—" : $"{v.ToString(v < 10 ? "0.00" : "0.0", CultureInfo.InvariantCulture)} ms";

    private static string Rate(JsonNode node, string section, string name)
        => $"{F(N(node, section, name, "10s"), 1)}  ·  {F(N(node, section, name, "60s"), 1)} (60 s)";

    /// <summary>A CL histogram, 1-10 … 41-50, as "27 · 3 · 0 · 0 · 0".</summary>
    private static string ClBands(JsonNode node, string who)
    {
        if (node?["progression"]?["bands"]?[who] is not JsonArray bands)
        {
            return "—";
        }

        var parts = new string[bands.Count];
        for (var i = 0; i < bands.Count; i++)
        {
            parts[i] = bands[i]?.ToString() ?? "0";
        }

        return string.Join(" · ", parts);
    }

    /// <summary>A band count array of <c>/swg/stats</c>'s <c>levels</c>, as "a / b / c / d / e".</summary>
    private static string Bands(JsonNode node, string name)
        => node?["levels"]?[name] is JsonArray bands
            ? string.Join(" / ", bands.Select(b => b is JsonValue v && v.TryGetValue<double>(out var d) ? F(d, 0) : "—"))
            : "—";

    /// <summary>Whether a band has no standing lair: the frontier patches squeezed, or a band's sites empty.</summary>
    private static bool EmptyBand(JsonNode node)
        => node?["levels"]?["lairsByBand"] is JsonArray bands && bands.Any(b => b is JsonValue v && v.TryGetValue<double>(out var d) && d == 0);

    private static bool Warn(double value, double limit) => !double.IsNaN(value) && !double.IsNaN(limit) && value > limit;

    private static string Pct(double part, double whole)
        => whole > 0 && !double.IsNaN(part) ? $"{Math.Clamp(part / whole * 100d, 0d, 100d).ToString("0.#", CultureInfo.InvariantCulture)}%" : "0%";

    private static string Age(DateTime at)
    {
        if (at == DateTime.MinValue)
        {
            return "—";
        }

        var s = (DateTime.UtcNow - at).TotalSeconds;
        return s < 90 ? $"{s:0} s" : $"{s / 60:0} min";
    }

    private static string Account(JsonNode id) => id?.ToString() == "0" ? "World" : $"#{id}";

    private static RenderFragment Kpi(string label, string value, bool alarm = false) => __builder =>
    {
        <div class="kpi @(alarm ? "alarm" : null)"><div class="value">@value</div><div class="label">@label</div></div>
    };

    private RenderFragment Spark(string series, string unit) => __builder =>
    {
        var values = Feed.History(series);
        if (values.Length < 2)
        {
            return;
        }

        var max = Math.Max(1e-9, values.Max());
        var points = string.Join(' ', values.Select((v, i) => string.Create(CultureInfo.InvariantCulture,
            $"{i * 300d / (DashboardFeed.HistoryLength - 1):0.#},{38 - (v / max * 36):0.#}")));
        <div class="spark">
            <svg viewBox="0 0 300 40" preserveAspectRatio="none"><polyline points="@points" /></svg>
            <span class="muted">@series — last 10 min, peak @F(max, 1)@unit</span>
        </div>
    };

    private static IEnumerable<(string Name, double Us)> Systems(JsonNode health)
        => (health?["systems"] as JsonArray ?? [])
            .Select(n => (Name: n?["name"]?.ToString() ?? "?", Us: N(n, "meanUs")))
            .Where(x => !double.IsNaN(x.Us))
            .OrderByDescending(x => x.Us)
            .Take(10);

    private static double MaxSystem(JsonNode health) => Systems(health).Select(x => x.Us).DefaultIfEmpty(1d).Max();

    /// <summary>The lootable items (inventory-loot.md § 3.1), the held-units table's rows in the catalogue's order, by asset id.</summary>
    private static readonly (string Id, string Name)[] Lootable =
    [
        ("mat_metal", "Metal"), ("mat_crystal", "Crystal"), ("mat_gas", "Gas"), ("mat_chemical", "Chemical"), ("mat_fiber", "Fiber"),
        ("mat_hide", "Hide"), ("mat_bone", "Bone"), ("mat_gland", "Gland"), ("mat_venom", "Venom"),
        ("core_ranged", "Ranged Weapon Core"), ("core_melee", "Melee Weapon Core"), ("core_armor", "Armor Core"), ("core_propulsion", "Propulsion Core"),
        ("addon_weapon", "Weapon Enhancement"), ("addon_armor", "Armor Enhancement"), ("addon_tuning", "Tuning Kit"), ("addon_additive", "Additive"),
    ];

    /// <summary>The 17 lootable items, then any other item the world holds (a later source), by its asset id.</summary>
    private static IEnumerable<(string Id, string Name)> HeldRows(JsonNode stats)
    {
        foreach (var row in Lootable)
        {
            yield return row;
        }

        foreach (var (id, _) in stats?["items"]?["held"] as JsonObject ?? [])
        {
            if (!Lootable.Any(l => l.Id == id))
            {
                yield return (id, id);
            }
        }
    }

    /// <summary>
    /// An item's held units as <c>/swg/stats</c> writes them: Mk I-V for an item with Mk, one count for one without (<c>SimBridge.ByTemplate</c>), so a single
    /// value is never read as Mk I. Empty for an item the world does not hold, which <c>held</c> leaves out.
    /// </summary>
    private static double[] Held(JsonNode stats, string id)
        => stats?["items"]?["held"]?[id] is JsonArray a
            ? a.Select(n => n is JsonValue v && v.TryGetValue<double>(out var d) ? d : 0d).ToArray()
            : [];

    /// <summary>One Mk's units (0-based) of an item with Mk; 0 where the array stops.</summary>
    private static double At(double[] held, int mk) => mk < held.Length ? held[mk] : 0d;

    /// <summary>A number of seconds as "45 s", "12 min" or "3.5 h".</summary>
    private static string Dur(double s)
        => double.IsNaN(s) ? "—" : s < 90 ? $"{F(s, 0)} s" : s < 5400 ? $"{F(s / 60d, 0)} min" : $"{F(s / 3600d, 1)} h";

    /// <summary>The price index's colour: green within 0.8 – 1.2 of the market value, red outside, none without a sale.</summary>
    private static string IndexColour(double index) => double.IsNaN(index) ? null : index is >= 0.8 and <= 1.2 ? "var(--good)" : "var(--bad)";

    private static string Roman(int mk) => mk switch { 1 => "I", 2 => "II", 3 => "III", 4 => "IV", 5 => "V", _ => "—" };

    private static string ItemName(string id) => Lootable.FirstOrDefault(l => l.Id == id).Name ?? id;

    /// <summary>The market's refusals since start, by reason (bazaar.md § 3.1).</summary>
    private static IEnumerable<(string Reason, double N)> Refused(JsonNode stats)
        => (stats?["market"]?["refused"] as JsonObject ?? [])
            .Select(p => (Reason: p.Key, N: p.Value is JsonValue v && v.TryGetValue<double>(out var d) ? d : 0d));

    /// <summary>The credits moved per credit kind since start (<c>economy.byKind</c>).</summary>
    private static IEnumerable<(string Kind, double Credits)> ByKind(JsonNode stats)
        => (stats?["economy"]?["byKind"] as JsonObject ?? [])
            .Select(p => (Kind: p.Key, Credits: p.Value is JsonValue v && v.TryGetValue<double>(out var d) ? d : 0d));

    /// <summary>Where a credit kind's money goes, as the server classes it (<c>MarketStats.CreditKinds</c>).</summary>
    private static string FlowOf(string kind) => kind switch
    {
        "grant" or "mission" or "vendor" => "faucet: minted",
        "tax" or "listfee" => "sink: destroyed",
        "tip" or "sale" => "wallet to wallet",
        _ => "",
    };

    private static IEnumerable<(string Name, double Listed, double Reserved, double Value)> MarketCities(JsonNode stats)
        => (stats?["market"]?["byCity"] as JsonArray ?? [])
            .Select(c => (Name: c?["name"]?.ToString() ?? "?", Listed: N(c, "listed"), Reserved: N(c, "reserved"), Value: N(c, "listedValue")));

    /// <summary>One price-index row: an item at one Mk, its recent sales, its listings, its market value — credits per unit.</summary>
    private readonly record struct PriceRow(string Id, int Mk, double Sales, double Median, double Min, double Max, double Value, double Listed, double Lowest);

    /// <summary>The <c>market.prices</c> rows, in the server's order (template, then Mk).</summary>
    private static IEnumerable<PriceRow> Prices(JsonNode stats)
    {
        foreach (var (id, entries) in stats?["market"]?["prices"] as JsonObject ?? [])
        {
            foreach (var e in entries as JsonArray ?? [])
            {
                yield return new PriceRow(id, (int)N(e, "mk"), N(e, "sales"), N(e, "median"), N(e, "min"), N(e, "max"), N(e, "value"), N(e, "listed"),
                    N(e, "lowest"));
            }
        }
    }

    private static IEnumerable<(string City, double Bots)> Cities(JsonNode stats)
        => (stats?["population"]?["botsByCity"] as JsonObject ?? [])
            .Select(p => (City: p.Key, Bots: p.Value is JsonValue v && v.TryGetValue<double>(out var d) ? d : 0d));
}
