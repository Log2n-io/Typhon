<Project Sdk="Microsoft.NET.Sdk">
  <!-- SwgTatooine.Tests — checks on the SWG demo's realms (Realms G1d): portals, inter-planet shuttles, realm isolation at scale. Beside the demo, like
       AntHill.Harness.Tests: it references the demo executable and builds small worlds with it. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <LangVersion>default</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="NUnit" Version="4.6.1" />
    <PackageReference Include="NUnit3TestAdapter" Version="6.2.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.7.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\SwgTatooine\SwgTatooine.csproj" />
    <ProjectReference Include="..\..\src\Typhon.Generators.Consumer\Typhon.Generators.Consumer.csproj" ReferenceOutputAssembly="false" OutputItemType="Analyzer" />
  </ItemGroup>
</Project>
