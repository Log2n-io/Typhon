<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <!-- netstandard2.1 for Unity (#1034), as Typhon.Protocol: the same sources, the BCL gaps filled for that target only. -->
        <TargetFrameworks>net10.0;netstandard2.1</TargetFrameworks>
        <LangVersion>latest</LangVersion>
        <RootNamespace>Typhon.Client</RootNamespace>
        <!-- XML doc file: the SDK is a product, raised to the engine's documentation bar (05-sdks § 3). -->
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <!-- Zero-warning policy, matching Typhon.Engine and Typhon.Profiler. -->
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    </PropertyGroup>

    <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.1'">
        <!-- The compiler-support types and argument guards netstandard2.1 lacks: Typhon.Protocol's, linked (internal, so each assembly has its copy). -->
        <Compile Include="..\Typhon.Protocol\Compat\*.cs" LinkBase="Compat" />
    </ItemGroup>

    <!-- ============ NuGet packaging (07-delivery § 5) ============ -->
    <PropertyGroup>
        <PackageId>Typhon.Client</PackageId>
        <Description>The .NET client SDK for Typhon Subscriptions: connects to a Typhon server over TCP or WebSocket, decodes its catalog-driven stream into a columnar world store, extrapolates motion, sends commands and subscribes to groups. Alpha — expect breaking changes.</Description>
        <PackageTags>typhon;replication;networking;client;game-client;realtime</PackageTags>
        <PackageReadmeFile>PACKAGE.md</PackageReadmeFile>
        <EnablePackageValidation>true</EnablePackageValidation>
    </PropertyGroup>

    <ItemGroup>
        <None Include="PACKAGE.md" Pack="true" PackagePath="" />
    </ItemGroup>

    <ItemGroup>
        <!-- PrivateAssets="none": the replication generator flows with it, for a client or bot that declares its own [ReplicatedMessage] types. -->
        <ProjectReference Include="..\Typhon.Protocol\Typhon.Protocol.csproj" PrivateAssets="none" />
    </ItemGroup>

    <ItemGroup>
        <!-- Entering and releasing slots is the applier's business, not an application's; the motion tests drive it the way the TypeScript SDK's vitest twins
             drive their public `WorldStore.enter`, so they need the same reach. -->
        <InternalsVisibleTo Include="Typhon.Client.Tests" />
    </ItemGroup>

</Project>
