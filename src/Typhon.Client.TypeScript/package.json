{
  "name": "@typhondb/client",
  "version": "0.0.0",
  "description": "TypeScript client SDK for Typhon Subscriptions: wire protocol codec, catalog-driven decoding, world store, motion segments, clock, aggregates.",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "typhon-codegen": "./bin/typhon-codegen.mjs"
  },
  "files": [
    "bin/typhon-codegen.mjs",
    "dist",
    "src"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "typecheck": "tsc --noEmit && tsc --noEmit -p test && tsc --noEmit -p bin && tsc --noEmit -p bench",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:f16-native": "vitest run test/f16-native.test.ts --execArgv=--js-float16array",
    "bench:decode": "npm run build && node --experimental-strip-types --no-warnings=ExperimentalWarning bench/decode-budget.ts",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.3",
    "eslint": "10.10.0",
    "prettier": "3.9.7",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "vitest": "5.0.1"
  }
}
