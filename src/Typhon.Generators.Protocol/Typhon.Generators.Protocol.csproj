<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <IsPackable>false</IsPackable>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.3.0" PrivateAssets="all" />
    <PackageReference Include="Microsoft.CodeAnalysis.Analyzers" Version="5.3.0" PrivateAssets="all" />
  </ItemGroup>

  <!--
    The replication generator, shipped inside the `Typhon.Protocol` package (07-delivery § 5).

    Its attributes ([Replicated], [ReplicatedMessage], [Codec]…) live in Typhon.Protocol, so a contracts assembly that references only Typhon.Protocol —
    shared by a server, its .NET clients and its bots — must get it. `Typhon` depends on `Typhon.Protocol` and lets its analyzers flow, so a server gets
    it from there, once; `Typhon`'s own analyzer (Typhon.Generators.Consumer) no longer carries it. Single source of truth: ReplicationGenerator.cs lives
    in Typhon.Generators (the engine's own build) and is linked here.
  -->
  <ItemGroup>
    <Compile Include="..\Typhon.Generators\ReplicationGenerator.cs" Link="ReplicationGenerator.cs" />
    <!-- TYPHON015 (#1614, shipped by #1584): a command sent by name while its [ReplicatedMessage] struct is in reach. It binds on Typhon.Client,
         and both a client and a server reference Typhon.Protocol, so this package is where it reaches every project that sends commands, once. -->
    <Compile Include="..\Typhon.Analyzers\TypedCommandAnalyzer.cs" Link="TypedCommandAnalyzer.cs" />
    <Compile Include="..\Typhon.Analyzers\DiagnosticHelp.cs" Link="DiagnosticHelp.cs" />
  </ItemGroup>

  <!-- Shipped diagnostic IDs are public contract (#1584): RS2008 release tracking. -->
  <ItemGroup>
    <AdditionalFiles Include="AnalyzerReleases.Shipped.md" />
    <AdditionalFiles Include="AnalyzerReleases.Unshipped.md" />
  </ItemGroup>

</Project>
